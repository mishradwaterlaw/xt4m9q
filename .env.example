# URL of the deployed frontend — used by FastAPI for CORS allow-origins
FRONTEND_URL=https://your-frontend.vercel.app

# URL of the deployed backend — used by React to call the API in production
# Leave empty in local dev — Vite proxy handles it automatically
VITE_API_URL=https://your-backend.railway.app

# Path to SQLite cache file inside the container
DB_PATH=/data/cache.db

# Root URL for the Elexon BMRS REST API (no trailing slash)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
